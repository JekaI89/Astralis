# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/astralis"
REDIS_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET="change_me_in_production"
JWT_EXPIRES_IN="7d"

# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"
TELEGRAM_WEBHOOK_SECRET="random_secret_string"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="AstralisAppBot"

# ─── AI ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# ─── External APIs ───────────────────────────────────────────
# Swiss Ephemeris / AstroAPI for planetary calculations
ASTRO_API_KEY="your_astro_api_key"

# ─── Web App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://app.astralis.io"
NEXT_PUBLIC_API_URL="https://api.astralis.io"

# ─── Push Notifications ──────────────────────────────────────
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_EMAIL="mailto:admin@astralis.io"

# ─── Storage ─────────────────────────────────────────────────
S3_BUCKET="astralis-assets"
S3_REGION="eu-central-1"
S3_ACCESS_KEY_ID="your_access_key"
S3_SECRET_ACCESS_KEY="your_secret_key"
